# Servidor
PORT=3000
NODE_ENV=development
API_VERSION=v1
BASE_URL=http://localhost:3000

# Base de datos
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/enviaya

# Seguridad — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_segura_y_larga

# CORS — URLs del frontend separadas por coma
# En producción pon la URL de Railway del frontend
CORS_ORIGIN=http://localhost:5173

# Email — SendGrid (alternativa)
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@enviaya.com
EMAIL_NAME=EnviaYa

# Email — EmailJS (verificación de cuentas)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_ORDER_TEMPLATE_ID=template_orders_xxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx
